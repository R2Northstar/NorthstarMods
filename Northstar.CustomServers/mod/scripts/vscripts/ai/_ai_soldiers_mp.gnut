untyped

global function CreateNPCSForDroppod
global function NPCSpawnFuncWrapper
// global function ShouldSpawnCaptain

// a unified function for spawning npc's in the droppod ( like the dropship has )
array function CreateNPCSForDroppod( int team, int count, vector spawnOrigin, vector spawnAngles, string squadName, bool force, entity functionref( int, vector, vector ) spawnFunc )
{
	if ( !ShouldSpawn( team, force ) ) // if ( IsAutoPopulateEnabled( team ) && !force ) // if ( !IsNPCSpawningEnabled( team ) && !force )
		return []

	array<entity> soldierEntities = []

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = NPCSpawnFuncWrapper( count, idx, spawnFunc, team, squadName, spawnOrigin, spawnAngles )

		if ( !ent )
			continue

		soldierEntities.append( ent )

		ent.Anim_ScriptedPlay( "pt_dp_idle_a" )
		ent.MakeInvisible()

		entity weapon = ent.GetActiveWeapon()

		if ( IsValid( weapon ) )
			weapon.MakeInvisible()

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	array finalSoldiers = []

	foreach ( soldier in soldierEntities )
	{
		if ( IsAlive( soldier ) )
			finalSoldiers.append( soldier )
	}

	return finalSoldiers
}

// this function allows you to pass a single spawnFunc or an array. That way you can spawn different kinds of AI in the same vehicle
entity function NPCSpawnFuncWrapper( int count, int index, entity functionref( int, vector, vector ) spawnFunc, int team, string squadName, vector origin, vector angles )
{
	Assert( type( spawnFunc ) == "function" )
	entity guy

	// if ( ShouldSpawnCaptain( count, index, spawnFunc ) )
	// 	guy = SpawnGruntCaptain( team, squadName, origin, angles )
	// else
	guy = spawnFunc( team, origin, angles )

	guy.kv.squadname = squadName

	DispatchSpawn( guy )

	return guy
}

