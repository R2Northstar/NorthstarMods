global function SpectreChatter_MP_Init
global function PlaySpectreChatterMPLine

void function SpectreChatter_MP_Init()
{
	#if SPECTRE_CHATTER_MP_ENABLED
	#endif
}

void function PlaySpectreChatterMPLine( entity spectre, string conversationType, bool forced = false )
{
	array<entity> players = GetPlayerArray()
	int conversationIndex = GetConversationIndex( conversationType )
	int spectreEHandle = spectre.GetEncodedEHandle()

	foreach ( entity player in players )
		if ( forced || ShouldPlaySpectreChatterMPLine( conversationType, player, spectre ) )
			Remote_CallFunction_Replay( player, "ServerCallback_PlaySpectreChatterMP", conversationIndex, spectreEHandle )
}
