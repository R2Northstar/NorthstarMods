bool function ShouldSpawnSpectre( int team )
{
	if ( Riff_AllowNPCs() != eAllowNPCs.Default )
		return ( Riff_AllowNPCs() == eAllowNPCs.SpectreOnly )

	if ( ( team == TEAM_IMC ) && ( Flag( "AllSpectreIMC" ) ) )
		return true

	if ( ( team == TEAM_MILITIA ) && ( Flag( "AllSpectreMilitia" ) ) )
		return true

	if ( ( team == TEAM_IMC ) && ( Flag( "NoSpectreIMC" ) ) )
		return false

	if ( ( team == TEAM_MILITIA ) && ( Flag( "NoSpectreMilitia" ) ) )
		return false

	if ( GetCurrentPlaylistVarInt( "no_spectres", 0 ) )
		return false

	if ( ( Flag( "AllSpectre" ) ) )
		return true

	int spectreCount = GetSpectreCount( team )
	int maxAI = GetMaxAICount( team )

	if ( spectreCount >= expect int( expect table( level.maxSpectrePerSide )[ team ] ) )
		return false

	return RandomInt( 100 ) <= expect int( expect table( level.spectreSpawnChance )[ team ] )
}

bool function ShouldSpawnStalker( int team )
{
	if ( Riff_AllowNPCs() != eAllowNPCs.Default )
		return false

	int stalkerCount = GetStalkerCount( team )
	int maxAI = GetMaxAICount( team )

	if ( stalkerCount >= expect int( expect table( level.maxStalkersPerSide )[ team ] ) )
		return false

	return RandomInt( 100 ) <= expect int( expect table( level.stalkerSpawnChance )[ team ] )
}

bool function ShouldSpawnReaper( int team )
{
	if ( Riff_AllowNPCs() != eAllowNPCs.Default )
		return false

	int reaperCount = GetReaperCount( team )
	int maxAI = GetMaxAICount( team )

	if ( reaperCount >= expect int( expect table( level.maxReapersPerSide )[ team ] ) )
		return false

	return RandomInt( 100 ) <= expect int( expect table( level.reaperSpawnChance )[ team ] )
}

void function ClearAndKillChildren( entity parentEnt, array<entity> excludedEntities )
{
	entity childEnt = parentEnt.FirstMoveChild()
	entity nextChildEnt

	while ( childEnt != null )
	{
		nextChildEnt = childEnt.NextMovePeer()

		childEnt.ClearParent()

		if ( !excludedEntities.contains( childEnt ) )
		{
			if ( childEnt.IsPlayer() )
			{
				if ( IsAlive( childEnt ) )
				{
					childEnt.SetOrigin( HIDDEN_AREA )
					childEnt.Die( svGlobal.worldspawn, svGlobal.worldspawn, { damageSourceId = eDamageSourceId.round_end } )
				}
			}
			else
			{
				ClearAndKillChildren( childEnt, excludedEntities )

				SetTeam( childEnt, TEAM_UNASSIGNED )

				childEnt.Destroy()
			}
		}

		childEnt = nextChildEnt
	}
}
