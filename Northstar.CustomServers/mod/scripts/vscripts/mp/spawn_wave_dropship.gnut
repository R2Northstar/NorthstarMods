untyped

global function DoWaveSpawnByDropship
global function WaveDropshipSpawnIsJoinable
global function CanSpawnIntoWaveSpawnDropship
global function CreateWaveSpawnDropship
global function SetWaveSpawnCustomDropshipAnim
global function GetWaveSpawnCustomPlayerRideAnimIdle
global function AddWaveSpawnCustomPlayerRideAnimIdle
global function GetWaveSpawnCustomPlayerRideAnimJump
global function AddWaveSpawnCustomPlayerRideAnimJump
global function AddWaveSpawnCustomSpawnPoint
global function GetWaveSpawnTime
global function SetWaveSpawnTime
global function IsFirstToDieAfterWaveSpawn
global function ShouldWaitForNextWaveSpawn
global function SetWaveSpawnProtection
global function ClearWaveSpawnProtectionOnPrimaryAttackOrDelay

struct
{
	array<void functionref( entity, string )> onWaveSpawnDropshipSpawned = []
	table<int, array<entity> > waveSpawnCustomSpawnPoints = {}
	string waveSpawnCustomDropshipAnim = "dropship_classic_mp_flyin"
	float dropshipSpawnTime = -1
	table<int, float> waveSpawnTime = {}
	array<FirstPersonSequenceStruct> waveSpawnCustomPlayerIdleAnim = []
	array<FirstPersonSequenceStruct> waveSpawnCustomPlayerJumpAnim = []
} file

void function DoWaveSpawnByDropship( entity player )
{
	int team = player.GetTeam()

	Assert( WaveDropshipSpawnIsJoinable( team ) )

	player.UnfreezeControlsOnServer()

	SpawnPlayerIntoSlotInDropship( player, true )
}

// if a joinable dropship wave spawn is happening right now return true
bool function WaveDropshipSpawnIsJoinable( int team )
{
	if ( GetGameState() != eGameState.Playing )
		return false

	if ( !expect array( expect table( level.classicMPDropships )[ team ] ).len() )
		return false

	float deployTime = GetAnimEventTime( DROPSHIP_MODEL, GetWaveSpawnCustomDropshipAnim(), "dropship_deploy" )
	float animTime = deployTime - GetWaveSpawnWindowTimeDropshipGone()

	if ( Time() > file.dropshipSpawnTime + animTime )
		return false

	return true
}

bool function CanSpawnIntoWaveSpawnDropship( entity player )
{
	if ( GetGameState() < eGameState.Playing )
		return false

	bool spawnAsTitan = expect bool( player.GetPersistentVar( "spawnAsTitan" ) )

	if ( ( spawnAsTitan || svGlobal.forceSpawnIntoTitan ) && PlayerCanSpawnIntoTitan( player ) )
		return false

	if ( ShouldSpawnAsTitan( player ) )
		return false

	int team = player.GetTeam()

	if ( !WaveDropshipSpawnIsJoinable( team ) )
		return false

	return true
}

// this just spawns the dropship - players will be added to this later
void function CreateWaveSpawnDropship( int team )
{
	// wait the proper ammount of time
	string anim = GetWaveSpawnCustomDropshipAnim()

	// find a spawnpoint
	array<entity> spawnpoints = GetEntArrayByClass_Expensive( "info_spawnpoint_dropship_start" )

	spawnpoints.reverse()

	if ( GetWaveSpawnCustomSpawnPoints( team ).len() )
		spawnpoints = GetWaveSpawnCustomSpawnPoints( team )

	vector origin = spawnpoints[ 0 ].GetOrigin()
	vector angles = spawnpoints[ 0 ].GetAngles()

	// warp in the ship
	asset model = $""

	if ( team == TEAM_IMC )
		model = $"models/vehicle/goblin_dropship/goblin_dropship_hero.mdl"
	else if ( team == TEAM_MILITIA )
		model = $"models/vehicle/crow_dropship/crow_dropship_hero.mdl"

	Assert( model.len() )

	waitthread WarpinEffect( model, anim, origin, angles )

	// spawn and animation the dropship
	entity ship = CreateDropship( team, origin, angles )

	ship.SetValueForModelKey( model )

	DispatchSpawn( ship )

	ship.SetModel( model )

	foreach ( ship in expect array( expect table( level.classicMPDropships )[ team ] ) )
	{
		if ( !IsAlive( expect entity( ship ) ) )
		{
			if ( expect array( expect table( level.classicMPDropships )[ team ] ).removebyvalue( ship ) )
			{
			}
		}
	}

	if ( expect array( expect table( level.classicMPDropships )[ team ] ).append( ship ) )
	{
	}

	file.dropshipSpawnTime = Time()
	ship.SetInvulnerable()
	ship.SetNoTarget( true )

	HideName( ship )

	AddAnimEvent( ship, "dropship_deploy", CleanupWaveSpawnDropship )

	PlayerSpawnDropship_RunSpawnCallbacks( ship, anim )

	waitthread PlayAnimTeleport( ship, anim, origin, angles )
}

void function CleanupWaveSpawnDropship( entity ship )
{
	int team = ship.GetTeam()

	if ( expect array( expect table( level.classicMPDropships )[ team ] ).removebyvalue( ship ) )
	{
	}

	delaythread( 0.05 ) ClearDropshipSpawnPlayerList( team )
}

void function SetWaveSpawnProtection( entity player )
{
	Assert( IsAlive( player ) && !expect table( player.s ).waveSpawnProtection )

	player.s.waveSpawnProtection = true
	player.SetNoTarget( true )
	player.SetInvulnerable()
}

void function ClearWaveSpawnProtectionOnPrimaryAttackOrDelay( entity player, float delay )
{
	if ( !expect table( player.s ).waveSpawnProtection )
		return

	OnThreadEnd(
		function() : ( player )
		{
			if ( IsValid( player ) )
			{
				player.s.waveSpawnProtection = false
				player.SetNoTarget( false )
				player.ClearInvulnerable()
			}
		}
	)

	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnPrimaryAttack" )

	wait delay
}

float function GetWaveSpawnWindowTimeDropshipGone()
{
	return 3.0 // if there is more then 3 seconds left before the wavespawn is over it's still not too late to get added to the dropship
}

string function GetWaveSpawnCustomDropshipAnim()
{
	return file.waveSpawnCustomDropshipAnim
}

void function SetWaveSpawnCustomDropshipAnim( string anim )
{
	file.waveSpawnCustomDropshipAnim = anim
}

FirstPersonSequenceStruct function GetWaveSpawnCustomPlayerRideAnimIdle( int index, FirstPersonSequenceStruct sequence )
{
	if ( index < file.waveSpawnCustomPlayerIdleAnim.len() )
		return file.waveSpawnCustomPlayerIdleAnim[ index ]

	return sequence
}

void function AddWaveSpawnCustomPlayerRideAnimIdle( FirstPersonSequenceStruct idleAnims )
{
	file.waveSpawnCustomPlayerIdleAnim.append( clone idleAnims )
}

FirstPersonSequenceStruct function GetWaveSpawnCustomPlayerRideAnimJump( int index, FirstPersonSequenceStruct sequence )
{
	if ( index < file.waveSpawnCustomPlayerJumpAnim.len() )
		return file.waveSpawnCustomPlayerJumpAnim[ index ]

	return sequence
}

void function AddWaveSpawnCustomPlayerRideAnimJump( FirstPersonSequenceStruct jumpAnims )
{
	file.waveSpawnCustomPlayerJumpAnim.append( clone jumpAnims )
}

array<entity> function GetWaveSpawnCustomSpawnPoints( int team )
{
	if ( team in file.waveSpawnCustomSpawnPoints )
		return file.waveSpawnCustomSpawnPoints[ team ]

	return []
}

void function AddWaveSpawnCustomSpawnPoint( int team, vector origin, vector angles )
{
	entity spawnPoint = CreateScriptRef( origin, angles )

	if ( !( team in file.waveSpawnCustomSpawnPoints ) )
		file.waveSpawnCustomSpawnPoints[ team ] <- []

	file.waveSpawnCustomSpawnPoints[ team ].append( spawnPoint )
}

float function GetWaveSpawnTime( int team )
{
	Assert( team == TEAM_IMC || team == TEAM_MILITIA )

	if ( team in file.waveSpawnTime )
		return file.waveSpawnTime[ team ]

	return 0.0
}

void function SetWaveSpawnTime( int team, float spawnTime )
{
	Assert( team == TEAM_IMC || team == TEAM_MILITIA )

	file.waveSpawnTime[ team ] <- spawnTime
}

bool function IsFirstToDieAfterWaveSpawn( entity player, float timeOfDeath )
{
	int team = player.GetTeam()
	float waveSpawnTime = GetWaveSpawnTime( team )

	if ( GetWaveSpawnType() == eWaveSpawnType.DISABLED )
		return false

	// don't do wave spawning if we are not playing
	if ( !GamePlayingOrSuddenDeath() )
		return false

	// are we within the grace period of a last wave spawn
	if ( Time() < waveSpawnTime + WAVE_SPAWN_GRACE_PERIOD )
		return false

	if ( timeOfDeath > waveSpawnTime )
		return true

	return false
}

bool function ShouldWaitForNextWaveSpawn( entity player )
{
	Assert( player.IsPlayer() )

	if ( GetWaveSpawnType() == eWaveSpawnType.DISABLED )
		return false

	// don't do wave spawning if we are not playing
	if ( !GamePlayingOrSuddenDeath() )
		return false

	// don't do wave spawn at the start of the match
	if ( GameTime_PlayingTime() < START_SPAWN_GRACE_PERIOD )
		return false

	int team = player.GetTeam()
	float waveSpawnTime = GetWaveSpawnTime( team )

	// if time is past the end of the wave spawn there is nothing to wait for.
	if ( Time() > waveSpawnTime )
		return false

	if ( !ShouldSpawnAsTitan( player ) )
	{
		if ( player.s.respawnSelectionDone )
		{
			float dropshipGoneTime = waveSpawnTime - GetWaveSpawnWindowTimeDropshipGone()

			// if we are within the window where the player can enter a dropship return false
			if ( Time() < dropshipGoneTime && WaveDropshipSpawnIsJoinable( team ) )
				return false
		}
	}
	else if ( player.s.respawnSelectionDone )
	{
		// if we selected to spawn as a titan stop observing and spawn immediately.
		return false
	}

	return true
}
