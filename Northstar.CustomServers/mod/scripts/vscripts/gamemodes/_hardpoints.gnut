untyped

global function Hardpoints_Init
global function OnHardpointEnter
global function OnHardpointLeave
global function Hardpoint_Think
global function TrackChevronStates
global function Hardpoints_OnPlayerKilled_UpdateMedals
global function NearHardpoint

global const INVALID_HARDPOINT_ID = 1023

// needed for sh_gamemode_cp_dialogue
global array<entity> HARDPOINTS

global struct HardpointState
{
	string group
	entity ent // CHardPoint
	entity trigger
	entity prop
	int oldState = CAPTURE_POINT_STATE_UNASSIGNED
	int oldTeam = TEAM_UNASSIGNED
	float lastTime = 0
	array<entity> capPlayers = []
}

global struct State
{
	bool ampingEnabled
	array<HardpointState> hardpoints
}

global State CPstate

void function Hardpoints_Init()
{
	RegisterSignal( "StopHardpointBehavior" )
	RegisterSignal( "HardpointCaptureStart" )
	RegisterSignal( "CapturePointStateChange" )
	RegisterSignal( "CapturePointPlayerLeft" )
	RegisterSignal( "CP_AWARD_TEAM_OWNED_POINTS_SIGNAL" )

	AddCallback_OnClientConnected( Hardpoint_OnClientConnected )

	CPstate.ampingEnabled = GetCurrentPlaylistVarInt( "capture_point_amping", 1 ) != 0
}

void function Hardpoint_OnClientConnected( entity player )
{
	player.s.isPlayingCapturingSound <- false
	player.s.isPlayingAmpingCapturingSound <- false
}

void function Hardpoints_OnPlayerKilled_UpdateMedals( entity victim, entity attacker, var damageInfo )
{
	// prevent non players from earning melads and prevent medals form suicide
	if ( !attacker.IsPlayer() || !victim.IsPlayer() || attacker == victim )
		return

	if (
		victim.GetPlayerNetInt( "playerHardpointID" ) != INVALID_HARDPOINT_ID &&
		victim.GetPlayerNetInt( "playerHardpointID" ) == attacker.GetPlayerNetInt( "playerHardpointID" )
	)
	{
		// victim hardpoint
		entity hardpoint
		foreach ( entity hp in HARDPOINTS )
		{
			if ( hp.GetHardpointID() == victim.GetPlayerNetInt( "playerHardpointID" ) )
				hardpoint = hp
		}

		if ( hardpoint == null )
			return

		if ( CapturePoint_GetOwningTeam( hardpoint ) == attacker.GetTeam() )
		{
			AddPlayerScore( attacker, "HardpointDefense", victim )
			attacker.AddToPlayerGameStat( PGS_DEFENSE_SCORE, POINTVALUE_HARDPOINT_DEFENSE )
			CheckPlayerChallenges( attacker )
		}
		else if ( CapturePoint_GetOwningTeam( hardpoint ) == victim.GetTeam() || CapturePoint_GetCappingTeam( hardpoint ) == victim.GetTeam() )
		{
			AddPlayerScore( attacker, "HardpointAssault", victim )
			attacker.AddToPlayerGameStat( PGS_ASSAULT_SCORE, POINTVALUE_HARDPOINT_ASSAULT )
			CheckPlayerChallenges( attacker )
		}
	}
	else if ( victim.GetPlayerNetInt( "playerHardpointID" ) != INVALID_HARDPOINT_ID ) // siege or snipe
	{
		if ( Distance( victim.GetOrigin(), attacker.GetOrigin() ) >= 1875 ) // 1875 inches(units) are 47.625 meters
		{
			AddPlayerScore( attacker, "HardpointSnipe", victim )
			attacker.AddToPlayerGameStat( PGS_ASSAULT_SCORE, POINTVALUE_HARDPOINT_SNIPE )
			CheckPlayerChallenges( attacker )
		}
		else
		{
			AddPlayerScore( attacker, "HardpointSiege", victim )
			attacker.AddToPlayerGameStat( PGS_ASSAULT_SCORE, POINTVALUE_HARDPOINT_SIEGE )
			CheckPlayerChallenges( attacker )
		}
	}
	else if ( victim.GetPlayerNetInt( "playerHardpointID" ) != INVALID_HARDPOINT_ID ) // Perimeter Defense
	{
		// attacker hardpoint
		entity hardpoint
		foreach ( entity hp in HARDPOINTS )
		{
			if ( hp.GetHardpointID() == attacker.GetPlayerNetInt( "playerHardpointID" ) )
				hardpoint = hp
		}

		if ( CapturePoint_GetOwningTeam( hardpoint ) == attacker.GetTeam() )
		{
			AddPlayerScore( attacker, "HardpointPerimeterDefense", victim )
			attacker.AddToPlayerGameStat( PGS_DEFENSE_SCORE, POINTVALUE_HARDPOINT_PERIMETER_DEFENSE )
			CheckPlayerChallenges( attacker )
		}
	}
}

void function OnHardpointEnter( entity trigger, entity player )
{
	entity hp = trigger.GetOwner()

	// don't handle anything other than players yet
	if ( !player.IsPlayer() )
		return

	// it's just too hard to handle emarking and disemarking with the count stuff
	HardpointState hpState = GetHardpointState( hp )

	if ( hpState.capPlayers.find( player ) == -1 )
		hpState.capPlayers.append( player )

	player.SetPlayerNetInt( "playerHardpointID", hp.GetHardpointID() )

	player.Signal( "CapturePointPlayerLeft" ) // reset this in case the function is called multiple times
	thread TrackPlayerScoreDefenseScore( player, hp )
}

void function OnHardpointLeave( entity trigger, entity player )
{
	entity hp = trigger.GetOwner()

	// don't handle anything other than players yet
	if ( !player.IsPlayer() )
		return

	// it's just too hard to handle emarking and disemarking with the count stuff
	HardpointState hpState = GetHardpointState( hp )

	int index = hpState.capPlayers.find( player )
	if ( index != -1 )
		hpState.capPlayers.fastremove( index )

	if ( player.s.isPlayingCapturingSound )
	{
		EmitSoundOnEntityOnlyToPlayer( hp, player, "Hardpoint_StopProgressBar_Event" )

		player.s.isPlayingCapturingSound = false
		player.s.isPlayingAmpingCapturingSound = false
	}

	player.SetPlayerNetInt( "playerHardpointID", INVALID_HARDPOINT_ID )
	player.Signal( "CapturePointPlayerLeft" )
}

void function Hardpoint_Think( HardpointState hardpoint )
{
	GM_AddPlayingThinkFunc(
		void function() : ( hardpoint )
		{
			Hardpoint_ThinkTick( hardpoint )
		}
	)

	// wait for game state playing otherwise vo might not correctly start
	WaittillGameStateOrHigher( eGameState.Playing )

	thread GamemodeCP_VO_Think( hardpoint.ent )
	// there is also a thing called GamemodeCP_VO_Approaching but respawn never used?

	hardpoint.lastTime = Time()

	WaittillGameStateOrHigher( eGameState.SuddenDeath )

	hardpoint.ent.Minimap_Hide( TEAM_MILITIA, null )
	hardpoint.ent.Minimap_Hide( TEAM_IMC, null )

	foreach ( entity player in hardpoint.capPlayers )
	{
		if ( player.s.isPlayingCapturingSound )
		{
			EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )

			player.s.isPlayingCapturingSound = false
			player.s.isPlayingAmpingCapturingSound = false
		}
	}
}

const HAS_IMC = 1
const HAS_MILITIA = 1 << 1
const HAS_IMC_TITAN = 1 << 2
const HAS_MILITIA_TITAN = 1 << 3
const CONTESTED = HAS_IMC | HAS_MILITIA | HAS_IMC_TITAN | HAS_MILITIA_TITAN
const IMC_HOLD = HAS_IMC | HAS_IMC_TITAN
const MILITIA_HOLD = HAS_MILITIA | HAS_MILITIA_TITAN
void function Hardpoint_ThinkTick( HardpointState hardpoint )
{
	int team_IMC_Player_Count = 0
	int team_IMC_Titan_Count = 0
	int team_Militia_Player_Count = 0
	int team_Militia_Titan_Count = 0

	// update counts based on capPlayers
	ArrayRemoveDead( hardpoint.capPlayers )

	foreach ( entity player in hardpoint.capPlayers )
	{
		if ( player.GetTeam() == TEAM_IMC )
		{
			team_IMC_Player_Count++

			if ( player.IsTitan() )
				team_IMC_Titan_Count++
		}
		else if ( player.GetTeam() == TEAM_MILITIA )
		{
			team_Militia_Player_Count++

			if ( player.IsTitan() )
				team_Militia_Titan_Count++
		}
	}

	hardpoint.ent.SetHardpointPlayerTitanCount( TEAM_IMC, team_IMC_Titan_Count )
	hardpoint.ent.SetHardpointPlayerCount( TEAM_IMC, team_IMC_Player_Count )
	hardpoint.ent.SetHardpointPlayerTitanCount( TEAM_MILITIA, team_Militia_Titan_Count )
	hardpoint.ent.SetHardpointPlayerCount( TEAM_MILITIA, team_Militia_Player_Count )

	int currentState = hardpoint.ent.GetHardpointState()
	int currentTeam = CapturePoint_GetOwningTeam( hardpoint.ent )
	int oldState = hardpoint.oldState
	int oldTeam = hardpoint.oldTeam
	float deltaTime = Time() - hardpoint.lastTime
	table capPower = GetCapPower( hardpoint.ent )

	// I am pretty sure it's just a check for if both teams are present not which one has more
	if ( capPower.contested )
	{
		CapturePoint_SetState( hardpoint.ent, CapturePoint_GetState( hardpoint.ent ) | CAPTURE_POINT_FLAGS_CONTESTED ) // add contested flag
		hardpoint.ent.SetHardpointState( CAPTURE_POINT_STATE_HALTED )
		hardpoint.ent.s.wasJustCapping = false

		foreach ( entity player in hardpoint.capPlayers )
		{
			if ( player.s.isPlayingCapturingSound )
			{
				EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )

				player.s.isPlayingAmpingCapturingSound = false
				player.s.isPlayingCapturingSound = false
			}
		}
	}
	else if ( capPower.strongerTeam != TEAM_UNASSIGNED )
	{
		CapturePoint_SetState( hardpoint.ent, CapturePoint_GetState( hardpoint.ent ) & ~CAPTURE_POINT_FLAGS_CONTESTED ) // remove contested flag
		CaptureHardPoint( hardpoint.ent, expect int( capPower.strongerTeam ), deltaTime, expect float( capPower.power ) )

		if (
			(
			( !CPstate.ampingEnabled && CapturePoint_GetCaptureProgress( hardpoint.ent ) < 1.0 ) ||
				( CPstate.ampingEnabled && CapturePoint_GetCaptureProgress( hardpoint.ent ) < 2.0 )
			) || ( CPstate.ampingEnabled && CapturePoint_GetCaptureProgress( hardpoint.ent ) >= 1.0 && CapturePoint_GetCaptureProgress( hardpoint.ent ) < 2.0 )
		)
		{
			foreach ( entity player in hardpoint.capPlayers )
			{
				if ( hardpoint.ent.s.lastCappedBy != player.GetTeam() )
				{
					EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )
					continue
				}

				if ( CapturePoint_GetOwningTeam( hardpoint.ent ) == player.GetTeam() && CPstate.ampingEnabled && CapturePoint_GetCaptureProgress( hardpoint.ent ) >= 1.0 )
				{
					if ( !player.s.isPlayingAmpingCapturingSound )
					{
						EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )
						EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_Amped_ProgressBar" )

						player.s.isPlayingAmpingCapturingSound = true
					}
				}
				else if ( !player.s.isPlayingCapturingSound || player.s.isPlayingAmpingCapturingSound )
				{
					EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )
					EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_ProgressBar" )

					player.s.isPlayingAmpingCapturingSound = false
				}

				player.s.isPlayingCapturingSound = true
			}
		}
		else
		{
			foreach ( entity player in hardpoint.capPlayers )
			{
				if ( player.s.isPlayingCapturingSound )
				{
					EmitSoundOnEntityOnlyToPlayer( hardpoint.ent, player, "Hardpoint_StopProgressBar_Event" )

					player.s.isPlayingAmpingCapturingSound = false
					player.s.isPlayingCapturingSound = false
				}
			}
		}
	}
	else
	{
		if ( hardpoint.ent.s.wasJustCapping )
		{
			thread AwardTeamOwnedPoints( hardpoint.ent )

			if ( CapturePoint_GetOwningTeam( hardpoint.ent ) != TEAM_UNASSIGNED )
			{
				CapturePoint_SetCappingTeam( hardpoint.ent, CapturePoint_GetOwningTeam( hardpoint.ent ) )

				hardpoint.ent.s.lastCappedBy = CapturePoint_GetOwningTeam( hardpoint.ent )
			}
		}

		hardpoint.ent.s.wasJustCapping = false
		CapturePoint_SetState( hardpoint.ent, CapturePoint_GetState( hardpoint.ent ) & ~CAPTURE_POINT_FLAGS_CONTESTED ) // remove contested flag
		if ( CapturePoint_GetCaptureProgress( hardpoint.ent ) <= 1.001 ) // unamp
		{
			if ( CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_AMPED && !IsValid( hardpoint.prop.GetParent() ) ) // only play 2inactive animation if we were amped
				thread PlayAnim( hardpoint.prop, "mh_active_2_inactive" )

			CapturePoint_SetState( hardpoint.ent, CapturePoint_GetState( hardpoint.ent ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag
			hardpoint.ent.SetHardpointState( CAPTURE_POINT_STATE_CAPTURED )
		}
		else
		{
			CapturePoint_SetCappingTeam( hardpoint.ent, TEAM_UNASSIGNED )

			hardpoint.ent.s.lastCappedBy = TEAM_UNASSIGNED
			hardpoint.ent.SetHardpointState( CAPTURE_POINT_STATE_SELF_UNAMPING )

			bool progressHasBeenSet = hardpoint.ent.GetHardpointEstimatedCaptureTime() >= 0
			float time = hardpoint.ent.GetHardpointProgressRefPoint() - CAPTURE_DURATION_CAPTURE
			float progress = GraphCapped( ( hardpoint.ent.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.ent.s.lastPower, 0, HARDPOINT_AMPED_DELAY, 1, 0 )

			if ( progressHasBeenSet )
				progress = Graph( progress, 0, 1, 1, 0 )

			hardpoint.ent.SetHardpointEstimatedCaptureTime( time + ( progress * ( HARDPOINT_AMPED_DELAY / 1 ) ) )
			hardpoint.ent.SetHardpointProgressRefPoint( time - deltaTime + CAPTURE_DURATION_CAPTURE )

			CapturePoint_SetCaptureProgress( hardpoint.ent, max( 1.0, min( 2.0, 1.0 - progress + 1.0 ) ) )

			hardpoint.ent.s.lastPower = 1.0

			if ( CapturePoint_GetCaptureProgress( hardpoint.ent ) <= 1.001 )
			{
				hardpoint.ent.SetHardpointEstimatedCaptureTime( -1 )
				hardpoint.ent.SetHardpointProgressRefPoint( CAPTURE_DURATION_CAPTURE )

				if ( CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_AMPED )
				{
					if ( !IsValid( hardpoint.ent.s.prop.GetParent() ) )
						thread PlayAnim( hardpoint.ent.s.prop, "mh_active_2_inactive" )

					CapturePoint_SetState( hardpoint.ent, CapturePoint_GetState( hardpoint.ent ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag

					hardpoint.ent.SetHardpointState( CAPTURE_POINT_STATE_CAPTURED )
				}
			}
		}
	}

	if (
		IsIMCOrMilitiaTeam( CapturePoint_GetOwningTeam( hardpoint.ent ) ) &&
		CapturePoint_GetCappingTeam( hardpoint.ent ) == GetOtherTeam( CapturePoint_GetOwningTeam( hardpoint.ent ) ) ||
		CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_CONTESTED
	)
		hardpoint.ent.s.trigger.Signal( "CP_AWARD_TEAM_OWNED_POINTS_SIGNAL" )

	table oldStates = { oldTeam = oldTeam, oldState = oldState }

	if ( oldState != hardpoint.ent.GetHardpointState() )
		hardpoint.ent.Signal( "CapturePointStateChange", oldStates )

	// update old stuff
	hardpoint.oldTeam = CapturePoint_GetOwningTeam( hardpoint.ent )
	hardpoint.oldState = hardpoint.ent.GetHardpointState()
	hardpoint.lastTime = Time()

	SetTeam( hardpoint.prop, CapturePoint_GetOwningTeam( hardpoint.ent ) ) // hardpoint has to have the correct color
}

void function CaptureHardPoint( entity hardpoint, int team, float deltaTime, float cappers )
{
	if ( CapturePoint_GetOwningTeam( hardpoint ) == TEAM_UNASSIGNED && CapturePoint_GetCappingTeam( hardpoint ) == GetOtherTeam( team ) )
		CaptureHardPointUnassigned( hardpoint, team, deltaTime, cappers )
	else if ( CapturePoint_GetOwningTeam( hardpoint ) != team && CapturePoint_GetOwningTeam( hardpoint ) != TEAM_UNASSIGNED )
		CaptureHardPointEnemy( hardpoint, team, deltaTime, cappers )
	else
		CaptureHardPointAllied( hardpoint, team, deltaTime, cappers )
}

void function CaptureHardPointAllied( entity hardpoint, int team, float deltaTime, float cappers )
{
	CapturePoint_SetCappingTeam( hardpoint, team )
	hardpoint.s.lastCappedBy = team

	if ( CapturePoint_GetCaptureProgress( hardpoint ) < 1.0 )
	{
		hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPPING )
		hardpoint.s.wasJustCapping = true

		bool progressHasBeenSet = hardpoint.GetHardpointEstimatedCaptureTime() >= 0
		float time = hardpoint.GetHardpointProgressRefPoint() + deltaTime
		float progress = GraphCapped( ( hardpoint.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.s.lastPower, 0, CAPTURE_DURATION_CAPTURE, 1, 0 )

		if ( progressHasBeenSet )
			progress = Graph( progress, 0, 1, 1, 0 )

		hardpoint.SetHardpointEstimatedCaptureTime( time + ( progress * ( CAPTURE_DURATION_CAPTURE / cappers ) ) )
		hardpoint.SetHardpointProgressRefPoint( time )

		CapturePoint_SetCaptureProgress( hardpoint, max( 0.0, min( 1.0, 1.0 - progress ) ) )

		if ( CapturePoint_GetCaptureProgress( hardpoint ) >= 1.0 )
		{
			hardpoint.SetHardpointEstimatedCaptureTime( -1 )
			hardpoint.SetHardpointProgressRefPoint( CAPTURE_DURATION_CAPTURE )

			SetCaptureHardpoint( hardpoint, team, true )
		}

		hardpoint.s.lastPower = cappers
	}
	else if ( CPstate.ampingEnabled ) // if the team exits the hardpoint before 0.0167 seconds after it can be amped, the enemy team can instant capture it. so don't remove else if
	{
		if ( CapturePoint_GetCaptureProgress( hardpoint ) >= 2.0 )
		{
			if ( !( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED ) )
				SetAmpedHardpoint( hardpoint, team )
		}
		else if ( CapturePoint_GetCaptureProgress( hardpoint ) >= 1.0 && hardpoint.GetHardpointState() >= CAPTURE_POINT_STATE_CAPTURED )
		{
			hardpoint.SetHardpointState( CAPTURE_POINT_STATE_AMPING )
			hardpoint.s.wasJustCapping = false

			CapturePoint_SetOwningTeam( hardpoint, team )

			bool progressHasBeenSet = hardpoint.GetHardpointEstimatedCaptureTime() >= 0
			float time = hardpoint.GetHardpointProgressRefPoint() + deltaTime - CAPTURE_DURATION_CAPTURE
			float progress = GraphCapped( ( hardpoint.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.s.lastPower, 0, HARDPOINT_AMPED_DELAY, 1, 0 )

			if ( progressHasBeenSet )
				progress = Graph( progress, 0, 1, 1, 0 )

			hardpoint.SetHardpointEstimatedCaptureTime( time + ( progress * ( HARDPOINT_AMPED_DELAY / cappers ) ) )
			hardpoint.SetHardpointProgressRefPoint( time + CAPTURE_DURATION_CAPTURE )

			CapturePoint_SetCaptureProgress( hardpoint, max( 1.0, min( 2.0, 1.0 - progress + 1.0 ) ) )

			hardpoint.s.lastPower = cappers
		}
	}

	if ( CapturePoint_GetCaptureProgress( hardpoint ) >= 1.0 && hardpoint.GetHardpointState() < CAPTURE_POINT_STATE_CAPTURED )
	{
		// eh
		if ( hardpoint.GetHardpointState() == CAPTURE_POINT_STATE_SELF_UNAMPING && CPstate.ampingEnabled )
			hardpoint.SetHardpointState( CAPTURE_POINT_STATE_AMPING )
		else if ( hardpoint.GetHardpointState() == CAPTURE_POINT_STATE_SELF_UNAMPING )
			hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPTURED )
		else
			SetCaptureHardpoint( hardpoint, team, false )
	}
}

void function CaptureHardPointEnemy( entity hardpoint, int team, float deltaTime, float cappers )
{
	CapturePoint_SetCappingTeam( hardpoint, team )
	hardpoint.s.lastCappedBy = team

	if ( CapturePoint_GetCaptureProgress( hardpoint ) > 1.001 )
	{
		hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPPING )
		hardpoint.s.wasJustCapping = true

		bool progressHasBeenSet = hardpoint.GetHardpointEstimatedCaptureTime() >= 0
		float time = hardpoint.GetHardpointProgressRefPoint() - CAPTURE_DURATION_CAPTURE
		float progress = GraphCapped( ( hardpoint.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.s.lastPower, 0, HARDPOINT_AMPED_DELAY, 1, 0 )

		if ( progressHasBeenSet )
			progress = Graph( progress, 0, 1, 1, 0 )

		hardpoint.SetHardpointEstimatedCaptureTime( time + ( progress * ( HARDPOINT_AMPED_DELAY / cappers ) ) )
		hardpoint.SetHardpointProgressRefPoint( time - deltaTime + CAPTURE_DURATION_CAPTURE )

		CapturePoint_SetCaptureProgress( hardpoint, max( 1.0, min( 2.0, 1.0 - progress + 1.0 ) ) )

		hardpoint.s.lastPower = cappers

		if ( CapturePoint_GetCaptureProgress( hardpoint ) <= 1.001 )
		{
			hardpoint.SetHardpointEstimatedCaptureTime( -1 )
			hardpoint.SetHardpointProgressRefPoint( CAPTURE_DURATION_CAPTURE )

			if ( ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED ) )
			{
				if ( !IsValid( hardpoint.s.prop.GetParent() ) )
					thread PlayAnim( hardpoint.s.prop, "mh_active_2_inactive" )

				CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag
			}
		}
	}
	else if ( CapturePoint_GetCaptureProgress( hardpoint ) <= 1.001 )
	{
		hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPPING )
		hardpoint.s.wasJustCapping = true

		float time = hardpoint.GetHardpointProgressRefPoint() - deltaTime
		float progress = GraphCapped( ( hardpoint.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.s.lastPower, 0, CAPTURE_DURATION_CAPTURE, 1, 0 )

		progress = Graph( progress, 0, 1, 1, 0 )

		hardpoint.SetHardpointEstimatedCaptureTime( time + ( progress * ( CAPTURE_DURATION_CAPTURE / cappers ) ) )
		hardpoint.SetHardpointProgressRefPoint( time )

		CapturePoint_SetCaptureProgress( hardpoint, max( 0.0, min( 1.0, 1.0 - progress ) ) )

		hardpoint.s.lastPower = cappers

		if ( ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED ) && CapturePoint_GetCaptureProgress( hardpoint ) <= 1.0 )
		{
			if ( !IsValid( hardpoint.s.prop.GetParent() ) )
				thread PlayAnim( hardpoint.s.prop, "mh_active_2_inactive" )

			CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag
		}
	}

	if ( CapturePoint_GetCaptureProgress( hardpoint ) == 0.0 )
	{
		if ( hardpoint.GetHardpointState() != CAPTURE_POINT_STATE_CAPTURED )
			SetCaptureHardpoint( hardpoint, team, true )

		CapturePoint_SetState( hardpoint, CAPTURE_POINT_STATE_CAPTURED )
		CapturePoint_SetOwningTeam( hardpoint, team )
		CapturePoint_SetCaptureProgress( hardpoint, 1.0 )
		CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag

		hardpoint.SetHardpointEstimatedCaptureTime( -1 )
		hardpoint.SetHardpointProgressRefPoint( CAPTURE_DURATION_CAPTURE )
	}

	HardpointState hpState = GetHardpointState( hardpoint )
}

void function CaptureHardPointUnassigned( entity hardpoint, int team, float deltaTime, float cappers )
{
	hardpoint.s.lastCappedBy = team

	if ( CapturePoint_GetCaptureProgress( hardpoint ) > 0.0 )
	{
		hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPPING )
		hardpoint.s.wasJustCapping = true

		float time = hardpoint.GetHardpointProgressRefPoint() - deltaTime
		float progress = GraphCapped( ( hardpoint.GetHardpointEstimatedCaptureTime() - time ) * hardpoint.s.lastPower, 0, CAPTURE_DURATION_CAPTURE, 1, 0 )

		progress = Graph( progress, 0, 1, 1, 0 )

		hardpoint.SetHardpointEstimatedCaptureTime( time + ( progress * ( CAPTURE_DURATION_CAPTURE / cappers ) ) )
		hardpoint.SetHardpointProgressRefPoint( time )

		CapturePoint_SetCaptureProgress( hardpoint, max( 0.0, min( 1.0, 1.0 - progress ) ) )

		hardpoint.s.lastPower = cappers

		if ( ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED ) && CapturePoint_GetCaptureProgress( hardpoint ) <= 1.0 )
		{
			if ( !IsValid( hardpoint.s.prop.GetParent() ) )
				thread PlayAnim( hardpoint.s.prop, "mh_active_2_inactive" )

			CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag
		}
	}

	if ( CapturePoint_GetCaptureProgress( hardpoint ) == 0.0 )
	{
		CapturePoint_SetCappingTeam( hardpoint, team )
		CapturePoint_SetState( hardpoint, CAPTURE_POINT_STATE_UNASSIGNED )
		CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) & ~CAPTURE_POINT_FLAGS_AMPED ) // remove amped flag
	}
}

void function SetCaptureHardpoint( entity hardpoint, int team, bool playSound )
{
	HardpointState hpState = GetHardpointState( hardpoint )

	hardpoint.SetHardpointState( CAPTURE_POINT_STATE_CAPTURED )

	CapturePoint_SetOwningTeam( hardpoint, team )
	thread AwardTeamOwnedPoints( hardpoint )

	if ( !playSound )
		return

	EmitSoundOnEntityToTeamExceptPlayer( hardpoint, "hardpoint_console_captured", team, null )
	GamemodeCP_VO_Captured( hardpoint )

	if ( !hardpoint.s.wasJustCapping )
		return

	foreach ( entity player in hpState.capPlayers )
	{
		// the team check is just for race conditions
		if ( player.IsPlayer() && player.GetTeam() == team )
		{
			// TODO: figure when assists happen
			AddPlayerScore( player, "ControlPointCapture" )
			player.AddToPlayerGameStat( PGS_ASSAULT_SCORE, POINTVALUE_HARDPOINT_CAPTURE )
			UpdatePlayerStat( player, "misc_stats", "hardpointsCaptured" )
			CheckPlayerChallenges( player )
		}
	}

	hardpoint.s.wasJustCapping = false
}

void function SetAmpedHardpoint( entity hardpoint, int team )
{
	HardpointState hpState = GetHardpointState( hardpoint )

	#if FACTION_DIALOGUE_ENABLED
		GamemodeCP_VO_Amped( hardpoint )
	#endif

	if ( !IsValid( hardpoint.s.prop.GetParent() ) )
		thread PlayAnim( hardpoint.s.prop, "mh_inactive_2_active" )

	hardpoint.SetHardpointState( CAPTURE_POINT_STATE_AMPED )
	CapturePoint_SetOwningTeam( hardpoint, team )

	// was already amped?
	if ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED )
		return

	foreach ( entity player in hpState.capPlayers )
	{
		// the team check is just for race conditions
		if ( player.IsPlayer() && player.GetTeam() == team )
		{
			AddPlayerScore( player, "ControlPointAmped" )
			player.AddToPlayerGameStat( PGS_DEFENSE_SCORE, POINTVALUE_HARDPOINT_AMPED )
			CheckPlayerChallenges( player )
		}
	}

	CapturePoint_SetState( hardpoint, CapturePoint_GetState( hardpoint ) | CAPTURE_POINT_FLAGS_AMPED ) // add amped flag
}

entity function AwardTeamOwnedPoints( entity hardpoint )
{
	hardpoint.s.trigger.Signal( "CP_AWARD_TEAM_OWNED_POINTS_SIGNAL" )

	EndSignal( hardpoint.s.trigger, "CP_AWARD_TEAM_OWNED_POINTS_SIGNAL" )

	int team = CapturePoint_GetOwningTeam( hardpoint )

	if ( team == TEAM_UNASSIGNED )
		return

	while ( GetGameState() == eGameState.Playing )
	{
		Wait( TEAM_OWNED_SCORE_FREQ )

		AddTeamScore( team, CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED ? TEAMPOINTVALUE_AMPED_HARDPOINT_OWNED : TEAMPOINTVALUE_HARDPOINT_OWNED )
	}
}

void function TrackChevronStates()
{
	GM_AddPlayingThinkFunc(
		void function() : ()
		{
			table<int, int> chevrons = { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }

			foreach ( HardpointState hardpoint in CPstate.hardpoints )
			{
				foreach ( int team, int chevronsCount in chevrons )
				{
					if ( team == CapturePoint_GetOwningTeam( hardpoint.ent ) && CapturePoint_GetCappingTeam( hardpoint.ent ) != GetOtherTeam( team ) )
					{
						// 4 is the value for a amped chevron
						chevrons[ team ] +=
							CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_AMPED
								? 5 - ( CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_CONTESTED ) * 5
								: 1 - ( CapturePoint_GetState( hardpoint.ent ) & CAPTURE_POINT_FLAGS_CONTESTED )
					}
				}
			}

			SetGlobalNetInt( "imcChevronState", chevrons[ TEAM_IMC ] )
			SetGlobalNetInt( "milChevronState", chevrons[ TEAM_MILITIA ] )
		}
	)

	WaittillGameStateOrHigher( eGameState.SuddenDeath )

	// reset chevrons after the match
	SetGlobalNetInt( "imcChevronState", 0 )
	SetGlobalNetInt( "milChevronState", 0 )
}

void function TrackPlayerScoreDefenseScore( entity player, entity hardpoint )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "CapturePointPlayerLeft" )

	while ( GetGameState() <= eGameState.Playing )
	{
		// player migth be capping the hardpoint then after they do cap it they won't earn score if it was in the while loop condition
		if ( CapturePoint_GetOwningTeam( hardpoint ) != player.GetTeam() )
		{
			WaitFrame()
			continue
		}

		// we wait before otherwise when the trigger is rapied fired the player will earn lots of score

		wait PLAYER_HELD_SCORE_FREQ

		if ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_CONTESTED )
			continue

		// not sure if players will still earn score if the hardpoint is contested
		if ( CapturePoint_GetState( hardpoint ) & CAPTURE_POINT_FLAGS_AMPED )
		{
			AddPlayerScore( player, "ControlPointAmpedHold" )
			player.AddToPlayerGameStat( PGS_DEFENSE_SCORE, POINTVALUE_HARDPOINT_AMPED_HOLD )
		}
		else
		{
			AddPlayerScore( player, "ControlPointHold" )
			player.AddToPlayerGameStat( PGS_DEFENSE_SCORE, POINTVALUE_HARDPOINT_HOLD )
		}

		CheckPlayerChallenges( player )
	}
}

HardpointState function GetHardpointState( entity hp )
{
	foreach ( hpState in CPstate.hardpoints )
	{
		if ( hpState.ent == hp )
			return hpState
	}
	unreachable
}

// respawn can't even really use their vo think function since the state var uses flags instead of state therefore this is correct
void function GamemodeCP_VO_Amped( entity hardpoint )
{
	PlayFactionDialogueToTeam( "amphp_youAmped" + CapturePoint_GetGroup( hardpoint ), CapturePoint_GetCappingTeam( hardpoint ) )
	PlayFactionDialogueToTeam( "amphp_enemyAmped" + CapturePoint_GetGroup( hardpoint ), GetOtherTeam( CapturePoint_GetCappingTeam( hardpoint ) ) )
}

void function CheckPlayerChallenges( entity player )
{
	if ( !HasPlayerCompletedMeritScore( player ) )
		return

	if ( player.GetPlayerGameStat( PGS_ASSAULT_SCORE ) >= 1000 )
		AddPlayerScore( player, "ChallengeCPAssault" )
	if ( player.GetPlayerGameStat( PGS_DEFENSE_SCORE ) >= 500 )
		AddPlayerScore( player, "ChallengeCPDefense" )
	else
		return
	SetPlayerChallengeMeritScore( player )
}

bool function NearHardpoint( vector dropPoint )
{
	foreach ( hpState in CPstate.hardpoints )
	{
		vector origin = hpState.ent.GetOrigin()

		if ( Distance( origin, dropPoint ) < SAFE_TITANFALL_DISTANCE )
			return true
	}

	return false
}
