struct
{
	table<string, array<string> > npcWeaponsTable // npcs have their default weapon in aisettings file
} file

void function AiGameModes_Init()
{
	FlagInit( "FrontlineInitiated" )

	RegisterSignal( "FreeAISlotsUpdated" )

	int npcPerSide = 12

	level.max_npc_per_side <- npcPerSide

	level.occupiedAISlots <- {}
	level.gameModeAICount <- {}

	level.npcRespawnWait <- 5

	level.modifyAISlots <- {}
	level.reservedAISquadSlots <- {}
	level.aiSpawnCounter <- {}

	level.spectreSpawnChance <- {}
	level.maxSpectrePerSide <- {}
	level.stalkerSpawnChance <- {}
	level.maxStalkersPerSide <- {}
	level.reaperSpawnChance <- {}
	level.maxReapersPerSide <- {}
	level.titanSpawnChance <- {}
	level.maxTitansPerSide <- {}

	for ( int i = 0; i < TEAM_COUNT; ++i )
	{
		level.occupiedAISlots[ i ] <- 0
		level.gameModeAICount[ i ] <- npcPerSide

		level.modifyAISlots[ i ] <- 0
		level.aiSpawnCounter[ i ] <- 0

		level.spectreSpawnChance[ i ] <- 0
		level.maxSpectrePerSide[ i ] <- 0
		level.stalkerSpawnChance[ i ] <- 0
		level.maxStalkersPerSide[ i ] <- 0
		level.reaperSpawnChance[ i ] <- 0
		level.maxReapersPerSide[ i ] <- 0
		level.titanSpawnChance[ i ] <- 0
		level.maxTitansPerSide[ i ] <- 0
	}
}

