// Globalize( Spawn_TrackedDropPodSpectreSquad )

array function Spawn_TrackedReaper( int team, int count, entity spawnPoint, string squadName )
{
	ToggleSpawnNodeInUse( spawnPoint, true )

	array<entity> reaperEntities = []

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = CreateSuperSpectre( team, spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

		if ( !ent )
			continue

		ent.kv.squadname = squadName

		SetSpawnOption_Titanfall( ent )
		SetSpawnOption_Warpfall( ent )
		SetSpawnOption_AISettings( ent, "npc_super_spectre_aitdm" )

		HideName( ent )

		DispatchSpawn( ent )

		thread void function() : ( ent )
		{
			WaitSignal( ent, "OnDestroy", "OnDeath", "WarpfallComplete" )

			if ( IsValid( ent ) )
				ShowName( ent )
		}()

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	array finalReapers = []

	foreach ( reaper in reaperEntities )
	{
		if ( IsAlive( reaper ) )
			finalReapers.append( reaper )
	}

	CommonTrackingInit( "npc_super_spectre", team, count, squadName )
	CommonTrackingCleanup( finalReapers, "npc_super_spectre", team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false ) // spawnPoint.s.inUse = false

	return finalReapers
}
