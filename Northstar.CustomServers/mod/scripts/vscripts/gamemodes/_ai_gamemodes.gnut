}

array<entity> function Spawn_TrackedWarpfallReaper( int team, int count, entity spawnPoint, string squadName = "", string aiSettings = "npc_super_spectre_aitdm" )
{
	if ( count > GetFreeAISlots( team ) )
		return []

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	CommonTrackingInit( "npc_super_spectre", team, count, squadName )

	array<entity> reaperEntities = []

	thread HotDrop_Spawnpoint( spawnPoint.GetOrigin(), team, 4.7 + 1.2, false, damagedef_reaper_fall )

	wait 4.7

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = CreateSuperSpectre( team, spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

		if ( !ent )
			continue

		reaperEntities.append( ent )

		Highlight_SetFriendlyHighlight( ent, "sp_friendly_pilot" )
		Highlight_SetEnemyHighlight( ent, "enemy_titan" )

		SetSpawnOption_Alert( ent )
		SetSpawnOption_Titanfall( ent )
		SetSpawnOption_Warpfall( ent )
		SetSpawnOption_AISettings( ent, aiSettings )

		HideName( ent )

		DispatchSpawn( ent )

		SetSquad( ent, squadName )

		thread void function() : ( ent )
		{
			WaitSignal( ent, "OnDestroy", "OnDeath", "WarpfallComplete" )

			if ( IsValid( ent ) )
				ShowName( ent )
		}()

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	ArrayRemoveDead( reaperEntities )

	CommonTrackingCleanup( reaperEntities, "npc_super_spectre", team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return reaperEntities
}

array<entity> function Spawn_TrackedTitanfallTitan( int team, int count, entity spawnPoint, string squadName = "", string setFile = "titan_atlas", string aiSettings = "" )
{
	if ( count > GetFreeAISlots( team ) )
		return []

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	CommonTrackingInit( "npc_titan", team, count, squadName )

	array<entity> titanEntities = []

	thread HotDrop_Spawnpoint( spawnPoint.GetOrigin(), team, 5.0, false, damagedef_titan_fall )

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = CreateNPCTitan( setFile, team, spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

		if ( !ent )
			continue

		titanEntities.append( ent )

		SetSpawnOption_Alert( ent )
		SetSpawnOption_Titanfall( ent )
		SetSpawnOption_AISettings( ent, aiSettings )

		DispatchSpawn( ent )

		SetSquad( ent, squadName )

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	ArrayRemoveDead( titanEntities )

	CommonTrackingCleanup( titanEntities, "npc_titan", team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return titanEntities
}

// copied from cl_replacement_titan_hud.gnut
void function HotDrop_Spawnpoint( vector origin, int team, float impactTime, bool hasFriendlyWarning = false, int damageDef = -1 )
{
	array<entity> targetEffects = []
	vector surfaceNormal = < 0, 0, 1 >
	int index = GetParticleSystemIndex( $"P_ar_titan_droppoint" )

	if ( hasFriendlyWarning )
	{
		entity effectFriendly = StartParticleEffectInWorld_ReturnEntity( index, origin, surfaceNormal )

		SetTeam( effectFriendly, team )
		EffectSetControlPointVector( effectFriendly, 1, FRIENDLY_COLOR_FX )

		effectFriendly.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY
		effectFriendly.DisableHibernation() // prevent it from fading out
		targetEffects.append( effectFriendly )
	}

	entity effectEnemy = StartParticleEffectInWorld_ReturnEntity( index, origin, surfaceNormal )

	SetTeam( effectEnemy, team )
	EffectSetControlPointVector( effectEnemy, 1, ENEMY_COLOR_FX )

	effectEnemy.kv.VisibilityFlags = ENTITY_VISIBLE_TO_ENEMY
	effectEnemy.DisableHibernation() // prevent it from fading out
	targetEffects.append( effectEnemy )

	// so enemy npcs will mostly avoid them
	entity damageAreaInfo

	if ( damageDef > -1 )
	{
		damageAreaInfo = CreateEntity( "info_target" )

		DispatchSpawn( damageAreaInfo )

		AI_CreateDangerousArea_DamageDef( damageDef, damageAreaInfo, team, true, true )
	}

	wait impactTime

	// clean up
	foreach ( entity targetEffect in targetEffects )
	{
		if ( IsValid( targetEffect ) )
			EffectStop( targetEffect )
	}

	if ( IsValid( damageAreaInfo ) )
		damageAreaInfo.Destroy()
}
