void function AiGameModes_Init()
{
	FlagInit( "FrontlineInitiated" )
	RegisterSignal( "FreeAISlotsUpdated" )

	level.max_npc_per_side <- 12

	int npcPerSide = expect int( level.max_npc_per_side )

	level.occupiedAISlots <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.gameModeAICount <- { [TEAM_IMC] = npcPerSide, [TEAM_MILITIA] = npcPerSide }
	level.midSpecAICount <- { [TEAM_IMC] = npcPerSide, [TEAM_MILITIA] = npcPerSide }
	level.npcRespawnWait <- 5

	SetGameModeAICount( npcPerSide, TEAM_IMC )
	SetGameModeAICount( npcPerSide, TEAM_MILITIA )

	SetMidSpecAICount( MID_SPEC_MAX_AI_COUNT, TEAM_IMC )
	SetMidSpecAICount( MID_SPEC_MAX_AI_COUNT, TEAM_MILITIA )

	level.modifyAISlots <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.reservedAISquadSlots <- {}
	level.aiSpawnCounter <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }

	level.spectreSpawnChance <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.maxSpectrePerSide <- { [TEAM_IMC] = -1, [TEAM_MILITIA] = -1 }

	level.stalkerSpawnChance <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.maxStalkersPerSide <- { [TEAM_IMC] = -1, [TEAM_MILITIA] = -1 }

	level.reaperSpawnChance <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.maxReapersPerSide <- { [TEAM_IMC] = -1, [TEAM_MILITIA] = -1 }

	level.titanSpawnChance <- { [TEAM_IMC] = 0, [TEAM_MILITIA] = 0 }
	level.maxTitansPerSide <- { [TEAM_IMC] = -1, [TEAM_MILITIA] = -1 }
}

