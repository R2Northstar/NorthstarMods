void function SetupTeamDeathmatchNPCs()
{
	FlagWait( "ReadyToStartMatch" )

	if ( InitFrontLine() )
	{
		FlagSet( "FrontlineInitiated" )

		// float waitTime = GameTime_TimeLeftSeconds() - expect float( GetDropPodAnimDuration() ) + 3

		// if ( GetGameState() <= eGameState.Prematch && waitTime > 0 )
		// 	wait waitTime

		WaittillGameStateOrHigher( eGameState.Playing )

		thread TeamDeathmatchSpawnNPCsThink()
	}
}

void function TeamDeathmatchSpawnNPCsThink()
{
	GameRules_SetTeamScore( 2, 500 )

	array<int> teams = [ TEAM_IMC, TEAM_MILITIA ]

	while ( IsNPCSpawningEnabled() )
	{
		if ( !Flag( "Disable_IMC" ) )
			thread TeamDeathmatchSpawnNPCs( TEAM_IMC )

		if ( !Flag( "Disable_MILITIA" ) )
			thread TeamDeathmatchSpawnNPCs( TEAM_MILITIA )

		wait level.npcRespawnWait
	}
}

void function TeamDeathmatchSpawnNPCs( int team )
{
	int numFreeSlots = GetFreeAISlots( team )

	while ( numFreeSlots >= GetSpawnSquadSize( team ) || ( ShouldSpawnReaper( team ) && numFreeSlots >= 1 ) )
	{
		// this will do all the heavy lifting of where and how many to spawn and what they should do once they are in the match.
		thread SpawnFrontlineSquad( team, numFreeSlots )

		// add a little wait so that we don't spawn squads at the exact same time.
		wait RandomFloatRange( 0.8, 2.0 )

		// the function above will have used up some free slots, lets see how many remain
		numFreeSlots = GetFreeAISlots( team )
	}
}

void function SpawnFrontlineSquad( int team, int numFreeSlots )
{
	if ( !IsAutoPopulateEnabled( team ) )
		return

	bool shouldSpawnReaper = ShouldSpawnReaper( team )
	bool shouldSpawnStalker = ShouldSpawnStalker( team )
	bool shouldSpawnSpectre = ShouldSpawnSpectre( team )
	string squadName = MakeSquadName( team, UniqueString( "" ) )
	int squadSize = int( min( numFreeSlots, GetSpawnSquadSize( team ) ) )

	if ( shouldSpawnReaper )
		squadSize = 1

	Assert( squadSize <= GetFreeAISlots( team ), "Squadsize " + squadSize + " is greater than remaining ai slots " + GetFreeAISlots( team ) )

	bool inGracePeriod = GameTime_PlayingTime() < START_SPAWN_GRACE_PERIOD
	bool inGameState = GetGameState() <= eGameState.Prematch || GetGameState() == eGameState.SwitchingSides
	bool useStartSpawn = inGameState || inGracePeriod
	array<entity> spawnPointArray

	if ( useStartSpawn )
	{
		spawnPointArray = SpawnPoints_GetDropPodStart( team )

		if ( !spawnPointArray.len() )
		{
			spawnPointArray = SpawnPoints_GetDropPod()
			useStartSpawn = false
		}
	}
	else
		spawnPointArray = SpawnPoints_GetDropPod()

	if ( !spawnPointArray.len() )
		return

	// if something got this far and we don't have any spawnpoints then something is wrong.
	Assert( spawnPointArray.len() )

	entity spawnPoint = GetFrontlineSpawnPoint( spawnPointArray, team )

	Assert( spawnPoint )

	++level.aiSpawnCounter[ team ]

	array npcArray

	if ( shouldSpawnReaper )
	{
		npcArray = Spawn_TrackedWarpfallReaper( team, squadSize, spawnPoint, squadName )
		return // reapers don't use frontline
	}
	if ( shouldSpawnStalker )
	{
		npcArray = Spawn_TrackedDropPodStalkerSquad( team, squadSize, spawnPoint, squadName )
		return // stalkers don't use frontline
	}
	else if ( shouldSpawnSpectre )
	{
		npcArray = Spawn_TrackedDropPodSpectreSquad( team, squadSize, spawnPoint, squadName )
	}
	else
	{
		if ( Flag( "DisableDropships" ) )
		{
			Assert( squadSize <= GetFreeAISlots( team ) )

			npcArray = Spawn_TrackedDropPodGruntSquad( team, squadSize, spawnPoint, squadName )
		}
		else
		{
			Assert( squadSize <= GetFreeAISlots( team ) )

			if ( ( useStartSpawn && expect int( expect table( level.aiSpawnCounter )[ team ] ) % 3 == 0 ) || GetZiplineDropshipSpawns().contains( spawnPoint ) ) // always spawn them if the droppod spot supports dropship spawns unless its using start spawns then 1 in every 3 grunt squad comes in via ship
				npcArray = Spawn_TrackedZipLineGruntSquad( team, squadSize, spawnPoint, squadName )
			else
				npcArray = Spawn_TrackedDropPodGruntSquad( team, squadSize, spawnPoint, squadName )
		}
	}

	array<entity> npcArrayEntity

	foreach ( npc in npcArray )
		npcArrayEntity.append( expect entity( npc ) )

	// make the squad assault the correct frontline
	SquadAssaultFrontline_Continuous( npcArrayEntity )
}

bool function SquadValidForClass( string squadName, string classnameToMatch )
{
	// if we have reserved squad slots they must be reserved by the correct class.
	if ( GetReservedAISquadSlots( squadName ) && !IsClassInReservedAISquadSlots_ForSquadName( squadName, classnameToMatch ) )
		return false

	int squadSize = GetNPCSquadSize( squadName )

	// empty squads are legit for any class;
	// also, can't GetNPCArrayBySquad if there are no NPCs with that squad set
	if ( !squadSize )
		return true

	array<entity> checkSquad = GetNPCArrayBySquad( squadName )

	foreach ( guy in checkSquad )
		if ( IsValid( guy ) && guy.GetClassName() != classnameToMatch )
			return false

	return true
}

void function SetNPCWeapons( string npcClass, array<string> weapons )
{
	if ( !( npcClass in file.npcWeaponsTable ) )
		file.npcWeaponsTable[ npcClass ] <- []

	file.npcWeaponsTable[ npcClass ] = weapons
}

void function SetUpNPCWeapons( entity guy )
{
	string className = guy.GetClassName()
	array<string> mainWeapons

	if ( className in file.npcWeaponsTable )
		mainWeapons = file.npcWeaponsTable[ className ]

	if ( !mainWeapons.len() ) // no valid weapons
		return

	string weaponName = mainWeapons[ RandomInt( mainWeapons.len() ) ]

	SetSpawnOption_Weapon( guy, weaponName )
}

