int function GetMaxAICount( int team )
{
	int AICount = expect int( expect table( level.gameModeAICount )[ team ] )

	return AICount
}

void function SetGameModeAICount( int count, int team )
{
	Assert( count <= level.max_npc_per_side, "Trying to set the AI count to more then max allowed (" + count + " vs 12)" )

	level.gameModeAICount[ team ] = count
}

int function GetSpawnSquadSize( int team )
{
	int maxAICount = GetMaxAICount( team )
	int squadSize = int( max( 1, floor( maxAICount / 3 ) ) ) // 3 is the number of squads we have per side.

	return int( min( squadSize, SQUAD_SIZE ) ) // never higher then SQUAD_SIZE, it's the max we can spawn with droppods
}

void function ReleaseAISlots( int team, int count = 1 )
{
	level.occupiedAISlots[ team ] -= count

	svGlobal.levelEnt.Signal( "FreeAISlotsUpdated" )
}

void function ReserveAISlots( int team, int count = 1 )
{
	level.occupiedAISlots[ team ] += count

	svGlobal.levelEnt.Signal( "FreeAISlotsUpdated" )
}

int function GetFreeAISlots( int team )
{
	int maxAICount = GetMaxAICount( team )
	int freeAISlots = maxAICount - expect int( expect table( level.occupiedAISlots )[ team ] )
	int modifyAISlots = expect int( expect table( level.modifyAISlots )[ team ] )

	return freeAISlots + modifyAISlots
}

void function ReleaseSquadSlots( string squadName, int count, string npcClass )
{
	Assert( squadName in level.reservedAISquadSlots )
	Assert( count >= 1 )
	Assert( level.reservedAISquadSlots[ squadName ].npcClass == npcClass )

	level.reservedAISquadSlots[ squadName ].count -= count

	Assert( level.reservedAISquadSlots[ squadName ].count >= 0 )

	// remove classname when reserved slots are zero
	if ( expect int( expect table( expect table( level.reservedAISquadSlots )[ squadName ] ).count ) == 0 )
		level.reservedAISquadSlots[ squadName ].npcClass = ""
}

void function ReserveSquadSlots( string squadName, int count, string npcClass, int team )
{
	if ( !squadName.len() )
		return

	if ( !( squadName in expect table( level.reservedAISquadSlots ) ) )
		level.reservedAISquadSlots[ squadName ] <- { count = 0, npcClass = "", team = team }

	string currentClass = expect string( expect table( expect table( level.reservedAISquadSlots )[ squadName ] ).npcClass )

	Assert(
		!currentClass.len() || currentClass == npcClass,
		"Can't reserve slot for npc of class " + npcClass + " in squad " + squadName + " because the NPC's classname doesn't match existing squad classname: " +
			currentClass
	)

	level.reservedAISquadSlots[ squadName ].count += count
	level.reservedAISquadSlots[ squadName ].npcClass = npcClass
}

int function GetReservedAISquadSlots( string squadName )
{
	if ( squadName in expect table( level.reservedAISquadSlots ) )
		return expect int( expect table( expect table( level.reservedAISquadSlots )[ squadName ] ).count )

	return 0
}

int function GetReservedAISquadSlotsOfClassForTeam( string npcClass, int team )
{
	int count = 0

	foreach ( Table in expect table( level.reservedAISquadSlots ) )
	{
		expect table( Table )

		if ( Table.team != team )
			continue

		if ( Table.npcClass == npcClass )
			count += expect int( Table.count )
	}

	return count
}

void function CommonTrackingInit( string ai_type, int team, int count, string squadName )
{
	Assert( ai_type.len() )

	ReserveAISlots( team, count )
	ReserveSquadSlots( squadName, count, ai_type, team )
}

void function CommonTrackingCleanup( array<entity> guys, string ai_type, int team, int count, string squadName )
{
	Assert( ai_type.len() )

	if ( count != guys.len() )
		ReleaseAISlots( team, count - guys.len() )

	ReleaseSquadSlots( squadName, count, ai_type )

	foreach ( entity npc in guys )
		FreeAISlotOnDeath( npc )
}

entity function Spawn_TrackedGrunt( int team, string squadName, vector origin, vector angles )
{
	entity soldier = CreateSoldier( team, origin, angles )

	SetSpawnOption_Alert( soldier )

	DispatchSpawn( soldier )

	SetSquad( soldier, squadName )

	Assert( IsAlive( soldier ) )

	ReserveAISlots( team )
	FreeAISlotOnDeath( soldier )

	return soldier
}

