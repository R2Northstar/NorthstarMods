array<entity> function Spawn_TrackedZipLineSquad( string ai_type, int count, entity spawnPoint, CallinData dropTable )
{
	int team = dropTable.team

	if ( count > GetFreeAISlots( team ) )
		return []

	if ( !IsValid( spawnPoint ) )
		return []

	string squadName = dropTable.squadname

	Assert( squadName.len() )

	CommonTrackingInit( ai_type, team, count, squadName )

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	thread RunDropshipDropoff( dropTable )

	array soldierEntities = []

	if ( dropTable.success )
	{
		// get the guys that spawned
		table results = WaitSignal( dropTable, "OnDropoff" )

		Assert( "guys" in results )

		if ( results.guys )
			soldierEntities = expect array( results.guys )
	}

	array<entity> soldierEntitiesEntity = []

	foreach ( guy in soldierEntities )
	{
		soldierEntitiesEntity.append( expect entity( guy ) )

		guy.Minimap_AlwaysShow( TEAM_MILITIA, null )
		guy.Minimap_AlwaysShow( TEAM_IMC, null )
	}

	CommonTrackingCleanup( soldierEntitiesEntity, ai_type, team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return soldierEntitiesEntity
}

array<entity> function Spawn_TrackedDropPodSquad( string ai_type, int team, int count, entity spawnPoint, string squadName = "", int flags = 0, entity functionref( int, vector, vector ) spawnFunc = null )
{
	if ( count > GetFreeAISlots( team ) )
		return []

	if ( !IsValid( spawnPoint ) )
		return []

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	CommonTrackingInit( ai_type, team, count, squadName )

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	entity dropPod = CreatePropDynamic( $"models/vehicle/droppod_fireteam/droppod_fireteam.mdl" ) // model is set in InitFireteamDropPod()

	InitFireteamDropPod( dropPod, flags )

	waitthread LaunchAnimDropPod( dropPod, "pod_testpath", spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

	if ( spawnFunc == null )
	{
		if ( ai_type == "npc_stalker" )
			spawnFunc = CreateStalker
		else if ( ai_type == "npc_spectre" )
			spawnFunc = CreateSpectre
		else
			spawnFunc = CreateSoldier
	}

	array<entity> soldierEntities = CreateNPCSForDroppod( team, count, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), squadName, spawnFunc )

	ActivateFireteamDropPod( dropPod, soldierEntities )

	CommonTrackingCleanup( soldierEntities, ai_type, team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return soldierEntities
}

void function FreeAISlotOnDeath( entity soldier )
{
	Assert( IsAlive( soldier ), soldier + " is not alive!" )

	thread FreeAISlotOnDeathThread( soldier )
}

void function FreeAISlotOnDeathThread( entity soldier )
{
	soldier.EndSignal( "OnDestroy" )

	int team = soldier.GetTeam() // wouldn't leeched spectres break team AI slot counts?

	OnThreadEnd(
		function() : ( team )
		{
			ReleaseAISlots( team )
		}
	)

	soldier.WaitSignal( "OnDeath" )
}

int function GetReservedSquadSize( string squadName )
{
	int squadSize = GetNPCSquadSize( squadName )

	squadSize += GetReservedAISquadSlots( squadName ) // add on any reserved AI squad slots

	return squadSize
}

bool function IsClassInReservedAISquadSlots_ForSquadName( string squadName, string npcClass )
{
	if (
		squadName in expect table( level.reservedAISquadSlots ) &&
		expect string( expect table( expect table( level.reservedAISquadSlots )[ squadName ] ).npcClass ) == npcClass
	)
		return true

	return false
}

array<entity> function Spawn_TrackedZipLineGruntSquad( int team, int count, entity spawnPoint, string squadName = "" )
{
	string ai_type = "npc_soldier"

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	CallinData dropTable = CreateZipLineSquadDropTable( team, count, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), squadName )

	return Spawn_TrackedZipLineSquad( ai_type, count, spawnPoint, dropTable )
}

array<entity> function Spawn_TrackedDropPodGruntSquad( int team, int count, entity spawnPoint, string squadName = "" )
{
	string ai_type = "npc_soldier"

	if ( !squadName.len() )
		squadName = MakeSquadName( team, UniqueString( "" ) )

	return Spawn_TrackedDropPodSquad( ai_type, team, count, spawnPoint, squadName )
}

