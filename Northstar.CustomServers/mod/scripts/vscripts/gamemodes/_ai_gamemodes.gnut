array function Spawn_TrackedZipLineSquad( string ai_type, entity spawnPoint, CallinData dropTable, bool force = false )
{
	if ( !spawnPoint )
		return []

	int team = dropTable.team
	int count = 4
	string squadName = dropTable.squadname

	Assert( squadName.len() )

	if ( !force )
		Assert( count <= GetFreeAISlots( team ), "wanted to spawn: " + count + " AI but only " + GetFreeAISlots( team ) + " slots where free" )

	CommonTrackingInit( ai_type, team, count, squadName )

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	thread RunDropshipDropoff( dropTable )

	array soldierEntities = []

	if ( dropTable.success )
	{
		// get the guys that spawned
		table results = WaitSignal( dropTable, "OnDropoff" )

		Assert( "guys" in results )

		if ( results.guys )
			soldierEntities = expect array( results.guys )
	}

	foreach ( guy in soldierEntities )
	{
		guy.Minimap_AlwaysShow( TEAM_MILITIA, null )
		guy.Minimap_AlwaysShow( TEAM_IMC, null )
	}

	CommonTrackingCleanup( soldierEntities, ai_type, team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return soldierEntities
}

array function Spawn_TrackedDropPodSquad( string ai_type, int team, int count, entity spawnPoint, string squadName = "", bool force = false, entity functionref( int, vector, vector ) spawnFunc = null )
{
	if ( !force )
		Assert( count <= GetFreeAISlots( team ), "wanted to spawn: " + count + " AI but only " + GetFreeAISlots( team ) + " slots where free" )

	if ( !IsValid( spawnPoint ) )
		return []

	CommonTrackingInit( ai_type, team, count, squadName )

	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	entity dropPod = CreatePropDynamic( $"models/vehicle/droppod_fireteam/droppod_fireteam.mdl" ) // model is set in InitFireteamDropPod()

	InitFireteamDropPod( dropPod )

	waitthread LaunchAnimDropPod( dropPod, "pod_testpath", spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

	if ( force )
		PlayFX( $"droppod_impact", spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

	if ( spawnFunc == null )
	{
		if ( ai_type == "npc_stalker" )
			spawnFunc = CreateStalker
		else if ( ai_type == "npc_spectre" )
			spawnFunc = CreateSpectre
		else
			spawnFunc = CreateSoldier
	}

	array soldierEntities = CreateNPCSForDroppod( team, count, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), squadName, force, spawnFunc )
	array<entity> soldierEntitiesEntity

	foreach ( npc in soldierEntities )
		soldierEntitiesEntity.append( expect entity( npc ) )

	ActivateFireteamDropPod( dropPod, soldierEntitiesEntity )

	CommonTrackingCleanup( soldierEntities, ai_type, team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return soldierEntities
}

void function FreeAISlotOnDeath( entity soldier )
{
	Assert( IsAlive( soldier ), soldier + " is not alive!" )

	thread FreeAISlotOnDeathThread( soldier )
}

void function FreeAISlotOnDeathThread( entity soldier )
{
	soldier.EndSignal( "OnDestroy" )

	int team = soldier.GetTeam() // wouldn't leeched spectres break team AI slot counts?

	OnThreadEnd(
		function() : ( team )
		{
			ReleaseAISlots( team )
		}
	)

	soldier.WaitSignal( "OnDeath" )
}

int function GetReservedSquadSize( string squadName )
{
	int squadSize = GetNPCSquadSize( squadName )

	squadSize += GetReservedAISquadSlots( squadName ) // add on any reserved AI squad slots

	return squadSize
}

bool function IsClassInReservedAISquadSlots_ForSquadName( string squadName, string npcClass )
{
	if ( squadName in expect table( level.reservedAISquadSlots ) )
	{
		if ( expect string( expect table( expect table( level.reservedAISquadSlots )[ squadName ] ).npcClass ) == npcClass )
			return true
	}

	return false
}

array function Spawn_TrackedZipLineGruntSquad( int team, int count, entity spawnPoint, string squadName )
{
	string ai_type = "npc_soldier"
	CallinData dropTable = CreateZipLineSquadDropTable( team, count, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), squadName )
	return Spawn_TrackedZipLineSquad( ai_type, spawnPoint, dropTable )
}

array function Spawn_TrackedDropPodGruntSquad( int team, int count, entity spawnPoint, string squadName )
{
	string ai_type = "npc_soldier"
	return Spawn_TrackedDropPodSquad( ai_type, team, count, spawnPoint, squadName )
}

array function Spawn_TrackedDropPodSpectreSquad( int team, int count, entity spawnPoint, string squadName )
{
	string ai_type = "npc_spectre"
	return Spawn_TrackedDropPodSquad( ai_type, team, count, spawnPoint, squadName )
}

array function Spawn_TrackedDropPodStalkerSquad( int team, int count, entity spawnPoint, string squadName )
{
	string ai_type = "npc_stalker"
	return Spawn_TrackedDropPodSquad( ai_type, team, count, spawnPoint, squadName )
}

array function Spawn_TrackedWarpfallReaper( int team, int count, entity spawnPoint, string squadName, string aiSettings = "npc_super_spectre_aitdm" )
{
	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	CommonTrackingInit( "npc_super_spectre", team, count, squadName )

	array<entity> reaperEntities = []

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = CreateSuperSpectre( team, spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

		if ( !ent )
			continue

		reaperEntities.append( ent )

		SetSpawnOption_Alert( ent )
		SetSpawnOption_Titanfall( ent )
		SetSpawnOption_Warpfall( ent )
		SetSpawnOption_AISettings( ent, aiSettings )

		HideName( ent )

		DispatchSpawn( ent )

		SetSquad( ent, squadName )

		thread void function() : ( ent )
		{
			WaitSignal( ent, "OnDestroy", "OnDeath", "WarpfallComplete" )

			if ( IsValid( ent ) )
				ShowName( ent )
		}()

		ent.Minimap_AlwaysShow( TEAM_MILITIA, null )
		ent.Minimap_AlwaysShow( TEAM_IMC, null )

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	array finalReapers = []

	foreach ( reaper in reaperEntities )
	{
		if ( IsAlive( reaper ) )
			finalReapers.append( reaper )
	}

	CommonTrackingCleanup( finalReapers, "npc_super_spectre", team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return finalReapers
}

array function Spawn_TrackedTitanfallTitan( int team, int count, entity spawnPoint, string squadName, string aiSettings )
{
	spawnPoint.e.spawnTime = Time()

	ToggleSpawnNodeInUse( spawnPoint, true )

	CommonTrackingInit( "npc_titan", team, count, squadName )

	array<entity> titanEntities = []

	for ( int idx = 0; idx < count; idx++ )
	{
		entity ent = CreateNPCTitan( aiSettings, team, spawnPoint.GetOrigin(), spawnPoint.GetAngles() )

		if ( !ent )
			continue

		titanEntities.append( ent )

		SetSpawnOption_Alert( ent )
		SetSpawnOption_Titanfall( ent )

		DispatchSpawn( ent )

		SetSquad( ent, squadName )

		ent.Minimap_AlwaysShow( TEAM_MILITIA, null )
		ent.Minimap_AlwaysShow( TEAM_IMC, null )

		wait 0
	}

	// because of wait 0 above, entities could die before returning
	array finalTitans = []

	foreach ( titan in titanEntities )
	{
		if ( IsAlive( titan ) )
			finalTitans.append( titan )
	}

	CommonTrackingCleanup( finalTitans, "npc_titan", team, count, squadName )
	ToggleSpawnNodeInUse( spawnPoint, false )

	return finalTitans
}

